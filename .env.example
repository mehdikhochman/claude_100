# ---------------------------------------------------------------------------
# LEGACY v2 — environment variables
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables.
# Empty values are treated as "not set".
# ---------------------------------------------------------------------------

# Postgres connection string (required). Must be a postgres:// or postgresql:// URL.
# Vercel Marketplace databases inject their own names; the app also accepts
# POSTGRES_PRISMA_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING, in that order of preference.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/legacy"

# A second database for the automated tests (Vitest migrates and wipes it).
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/legacy_test"

# Signs the login cookie (required). Generate one: openssl rand -base64 32
SESSION_SECRET=""

# First admin account, created by the seed when the database is empty.
SEED_ADMIN_EMAIL="admin@legacy.studio"
SEED_ADMIN_PASSWORD="change-me-please"

# IANA timezone the studio operates in. Everything is displayed in this zone.
STUDIO_TIMEZONE="Africa/Abidjan"

# Vercel Blob read-write token for member photos. Leave empty locally
# (photos are then stored in .data/avatars). Required in production for uploads.
BLOB_READ_WRITE_TOKEN=""
